# Database (same Postgres as admin; store only generates its Prisma client)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop?schema=public"

# Better Auth (store / customer pool)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3002"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3002"

# Admin API base, including the store id, e.g.:
# http://localhost:3001/api/<storeId>
NEXT_PUBLIC_API_URL="http://localhost:3001/api/STORE_ID"

# Public base URL of MinIO (for Next/Image product image display)
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000"

# Canonical production domain used for SEO metadata (canonical URLs, hreflang,
# JSON-LD, sitemap, robots). Must be the real public domain, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://liletti.delice.my"

# AI shop assistant (server-side only)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Assistant context limits
ASSISTANT_MAX_HISTORY="8"
ASSISTANT_MAX_PRODUCTS="5"
ASSISTANT_MAX_KNOWLEDGE="6"
ASSISTANT_MAX_ORDERS="3"

# Assistant per-client rate limit
ASSISTANT_RATE_LIMIT_WINDOW_MS="60000"
ASSISTANT_RATE_LIMIT_MAX="12"

# Virtual try-on (AI-generated model wearing the product; preset styles, no
# shopper photo upload). Enabled server-side purely by the presence of
# OPENAI_API_KEY — the PDP passes `enabled` to the UI at request time.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_IMAGE_SIZE="1024x1536"
