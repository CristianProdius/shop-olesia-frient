# Database (shared Postgres for both apps)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop?schema=public"

# Better Auth (admin / staff pool)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3001"

# Store front URL (used for CORS / redirects)
FRONTEND_STORE_URL="http://localhost:3002"

# Transactional email (Resend). Optional: if RESEND_API_KEY is unset/empty,
# emails are SKIPPED (logged + no-op) and checkout / order updates still work.
RESEND_API_KEY=
# From address for outgoing emails. Falls back to "LILETTI <onboarding@resend.dev>".
EMAIL_FROM=

# Anthropic (Trilingual AI Copy Studio). Optional: if ANTHROPIC_API_KEY is
# unset/empty, the AI Copy Studio is DISABLED — the ✨ Generate / Translate
# buttons render greyed out and the /api/ai/generate route returns 503. The key
# is server-only and never reaches the browser.
ANTHROPIC_API_KEY=

# MinIO / S3-compatible object storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="shop-images"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000"
